# SSH/Mosh Telegram Mini App - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# Telegram Bot Configuration
# =============================================================================

# Telegram Bot Token - Get this from @BotFather on Telegram
BOT_TOKEN=your_telegram_bot_token_here

# =============================================================================
# Security Configuration
# =============================================================================

# Master encryption key for securing stored credentials
# Generate a secure key using: openssl rand -hex 32
MASTER_KEY=your_master_key_here_generate_with_openssl_rand_hex_32

# =============================================================================
# Database Configuration
# =============================================================================

# Path to SQLite database file
DATABASE_PATH=/app/data/ssh-miniapp.db

# =============================================================================
# Server Configuration
# =============================================================================

# Server port
PORT=3000

# Node environment: development, production, test
NODE_ENV=development

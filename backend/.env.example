# Telegram Bot Token (required)
BOT_TOKEN=your_telegram_bot_token_here

# Master encryption key (required) - generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=your_64_char_hex_master_key_here

# Server port (optional, default: 3000)
PORT=3000

# Database path (optional, default: ./data/ssh-miniapp.db)
DATABASE_PATH=./data/ssh-miniapp.db

# Frontend path (optional, default: ../frontend/dist)
FRONTEND_PATH=../frontend/dist

# Node environment (optional, default: development)
NODE_ENV=development
